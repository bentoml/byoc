{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Parameters": {
    "BentoCloudCopilot": {
      "Type": "String",
      "Default": "arn:aws:iam::303081928216:role/bentocloud-dummy"
    }
  },
  "Outputs": {
    "InstallerRole": {
      "Value": {
        "Fn::GetAtt": [
          "BentoCloudInstaller",
          "Arn"
        ]
      },
      "Description": "The ARN of the installer role"
    }
  },
  "Resources": {
    "BentoCloudInstaller": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": [
                  {
                    "Ref": "BentoCloudCopilot"
                  }
                ]
              },
              "Action": "sts:AssumeRole",
              "Condition": {}
            }
          ]
        },
        "Path": "/",
        "Policies": [
          {
            "PolicyName": "BentoCloudAdminPolicy",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "VisualEditor0",
                  "Effect": "Allow",
                  "Action": [
                    "kms:*",
                    "logs:*",
                    "memorydb:*",
                    "autoscaling:*",
                    "s3:*",
                    "ecr:*",
                    "eks:*",
                    "iam:*"
                  ],
                  "Resource": [
                    "arn:aws:s3:::bc-*",
                    "arn:aws:s3:::bentocloud-*",
                    "arn:aws:iam::*:user/bc-*",
                    "arn:aws:iam::*:user/bentocloud-*",
                    "arn:aws:memorydb:*:*:subnetgroup/bc-*",
                    "arn:aws:memorydb:*:*:subnetgroup/bentocloud-*",
                    "arn:aws:iam::*:role/bentocloud-*",
                    "arn:aws:kms:*:*:key/*",
                    "arn:aws:kms:*:*:alias/eks/bentocloud-*",
                    "arn:aws:memorydb:*:*:cluster/bc-*",
                    "arn:aws:memorydb:*:*:cluster/bentocloud-*",
                    "arn:aws:eks:*:*:cluster/bentocloud-*",
                    "arn:aws:eks:*:*:access-entry/bentocloud-*/*",
                    "arn:aws:eks:*:*:nodegroup/bentocloud-*",
                    "arn:aws:ecr:*:*:repository/bentocloud-*",
                    "arn:aws:iam::*:policy/bentocloud-*"
                  ]
                },
                {
                  "Sid": "Statement1",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:DescribeAvailabilityZones",
                    "ec2:DescribeVPCs",
                    "ec2:DescribeSubnets",
                    "ec2:DescribeNetworkInterfaces",
                    "ec2:DescribeInternetGateways",
                    "ec2:DescribeRouteTables",
                    "ec2:DescribeSecurityGroups",
                    "ec2:DescribeTags",
                    "ec2:DescribeLaunchTemplates",
                    "ec2:DescribeLaunchTemplateVersions",
                    "ec2:RunInstances",
                    "kms:ListAliases",
                    "kms:CreateKey",
                    "eks:DescribeAddonVersions",
                    "eks:DescribeAddon",
                    "eks:DeleteAddon",
                    "iam:CreateOpenIDConnectProvider",
                    "iam:DeleteOpenIDConnectProvider",
                    "iam:TagOpenIDConnectProvider",
                    "iam:GetOpenIDConnectProvider",
                    "iam:GetRole",
                    "iam:GetPolicy",
                    "iam:CreatePolicy",
                    "iam:CreateServiceLinkedRole",
                    "iam:DeletePolicy",
                    "iam:GetPolicyVersion",
                    "iam:ListPolicyVersions",
                    "ec2:CreateLaunchTemplate",
                    "ec2:DeleteLaunchTemplate",
                    "ec2:DescribeVpcAttribute",
                    "ec2:CreateVPC",
                    "ec2:CreateSubnet",
                    "ec2:DeleteSubnet",
                    "ec2:ModifySubnetAttribute",
                    "ec2:CreateInternetGateway",
                    "ec2:AttachInternetGateway",
                    "ec2:DeleteInternetGateway",
                    "ec2:CreateRouteTable",
                    "ec2:DeleteRouteTable",
                    "ec2:CreateRoute",
                    "ec2:DeleteRoute",
                    "ec2:AssociateRouteTable",
                    "ec2:DisassociateRouteTable",
                    "ec2:ReplaceRouteTableAssociation",
                    "ec2:CreateSecurityGroup",
                    "ec2:DeleteSecurityGroup",
                    "ec2:RevokeSecurityGroupEgress",
                    "ec2:CreateTags",
                    "ec2:DeleteTags",
                    "autoscaling:CreateOrUpdateTags",
                    "autoscaling:DeleteTags",
                    "autoscaling:DescribeTags",
                    "memorydb:CreateCluster",
                    "ec2:CreateVpcEndpoint",
                    "ec2:DescribeVpcEndpoints",
                    "ec2:DescribePrefixLists",
                    "ec2:DescribeInstances",
                    "ec2:CreateInstanceConnectEndpoint",
                    "ec2:CreateNetworkInterface",
                    "ec2:DescribeInstanceConnectEndpoints",
                    "ec2:DeleteInstanceConnectEndpoint",
                    "ec2-instance-connect:OpenTunnel"
                  ],
                  "Resource": [
                    "*"
                  ]
                },
                {
                  "Sid": "Statement2",
                  "Effect": "Allow",
                  "Action": [
                    "*",
                    "ec2:*",
                    "eks:*",
                    "ec2-instance-connect:*"
                  ],
                  "Resource": [
                    "*"
                  ],
                  "Condition": {
                    "StringEquals": {
                      "ec2:ResourceTag/Owner": "bentocloud"
                    }
                  }
                },
                {
                  "Sid": "Statement3",
                  "Effect": "Allow",
                  "Action": [
                    "iam:GetRole"
                  ],
                  "Resource": [
                    "arn:aws:iam::*:role/BentoCloudAdminTest",
                    "arn:aws:iam::*:role/BentoCloudAdmin"
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  }
}
